{
  "manifest_version": 3,
  "name": "DomainVoodoo — Instant Domain Valuation",
  "version": "1.0.0",
  "description": "Instant algorithmic domain valuation, multi-channel pricing, and UDRP legal risk scanning on any website.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Appraise Domain with DomainVoodoo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://prstuvw.xyz/*",
    "http://localhost:3000/*"
  ]
}
